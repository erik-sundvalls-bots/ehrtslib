        >
    details = <
            ["en"] = <
                language = <[ISO_639-1::en]>
                purpose = <"Not Specified">
            >
        >
    lifecycle_state = <"Initial">

definition
    use_archetype COMPOSITION[at0000, openEHR-EHR-COMPOSITION.minimal.v1] occurrences matches {1..1} matches {
        category existence matches {1..1} matches {
            DV_CODED_TEXT[at0003] occurrences matches {1..1} matches {
                defining_code existence matches {1..1} matches {
                    [openehr::433]
                }
            }
        }
        content existence matches {0..1} cardinality matches {0..*; unordered} matches {
            use_archetype EVALUATION[at0000, openEHR-EHR-EVALUATION.minimal.v1] occurrences matches {0..*} matches {
                data existence matches {1..1} matches {
                    ITEM_TREE[at0001] occurrences matches {1..1} matches {
                        items existence matches {0..1} cardinality matches {0..*; unordered} matches {
                            ELEMENT[at0002] occurrences matches {0..1} matches {
                                value existence matches {0..1} matches {
                                    DV_QUANTITY[at0003] occurrences matches {1..1} matches {
                                        property matches {[openehr::124]}
                                        units matches {"kg", "mg", "gm"}
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

